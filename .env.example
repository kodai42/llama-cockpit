# llama-server path (REQUIRED)
LLAMA_SERVER=/path/to/llama.cpp/build/bin/llama-server

# PID and log file locations
LLAMA_PIDFILE=/tmp/llama-server.pid
LLAMA_LOG=/tmp/llama-server.log

# Cockpit dashboard host and port
COCKPIT_HOST=127.0.0.1
COCKPIT_PORT=5000

# Default llama-server port
LLAMA_PORT=8080

# Custom index.html path (optional)
COCKPIT_INDEX_FILE=index.html
